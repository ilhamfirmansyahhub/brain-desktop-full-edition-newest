    // =========================================================================
    // Runtime data
    // =========================================================================

    property var keybinds: ({})

    property var _hyprBinds: []

    // =========================================================================
    // Hyprland bind scanner
    // =========================================================================

    property var _hyprBindsProc: Process {
        command: ["hyprctl", "binds", "-j"]
        running: false

        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    root._hyprBinds = JSON.parse(text.trim())
                } catch (e) {
                    root._hyprBinds = []
                }
            }
        }
    }

    function loadHyprBinds() {
        _hyprBindsProc.running = false
        _hyprBindsProc.running = true
    }

    function _modsToMask(modsStr) {
        var mask = 0
        var parts = (modsStr || "").toUpperCase().split("+")

        for (var i = 0; i < parts.length; i++) {
            var p = parts[i].trim()

            if      (p === "SUPER") mask |= 64
            else if (p === "SHIFT") mask |= 1
            else if (p === "CTRL")  mask |= 4
            else if (p === "ALT")   mask |= 8
        }

        return mask
    }


    // =========================================================================
    // Hyprland conflict detection
    // =========================================================================

    function wouldConflictHypr(action, mods, key) {
        var mask = _modsToMask(mods)
        var wantedKey = (key || "").toLowerCase()

        // First check other Brain-managed actions.
        var ownKeys = Object.keys(root.keybinds)

        for (var oi = 0; oi < ownKeys.length; oi++) {
            var ownAction = ownKeys[oi]

            if (ownAction === action)
                continue

            var own = root.keybinds[ownAction]

            if (!own || !own.mods || !own.key)
                continue

            if (_modsToMask(own.mods) === mask &&
                own.key.toLowerCase() === wantedKey) {
                return own.label || ownAction
            }
        }

        // Then check Hyprland itself.
        for (var i = 0; i < root._hyprBinds.length; i++) {
            var b = root._hyprBinds[i]

            if (b.submap !== "")
                continue

            if (b.mouse)
                continue

            if ((b.key || "").toLowerCase() !== wantedKey)
                continue

            if (b.modmask !== mask)
                continue

            // Ignore our own generated Brain bindings.
            if (b.arg && b.arg.indexOf("qs ipc") >= 0)
                continue

            // Ignore the currently assigned combo of this action.
            var current = root.keybinds[action]

            if (current &&
                _modsToMask(current.mods) === mask &&
                (current.key || "").toLowerCase() === wantedKey) {
                continue
            }

            var desc = b.dispatcher || ""

            if (b.arg)
                desc += ": " + b.arg.substring(0, 60)

            return desc || "Hyprland bind"
        }

        return ""
    }


    // =========================================================================
    // Duplicate detection
    // =========================================================================

    readonly property var _comboMap: {
        var m = {}
        var ks = Object.keys(root.keybinds)

        for (var i = 0; i < ks.length; i++) {
            var b = root.keybinds[ks[i]]

            if (!b || !b.mods || !b.key)
                continue

            var combo =
                b.mods.toUpperCase().trim() +
                "+" +
                b.key.toUpperCase().trim()

            if (!m[combo])
                m[combo] = [ks[i]]
            else
                m[combo] = m[combo].concat([ks[i]])
        }

        return m
    }

    function isDuplicate(action) {
        var b = root.keybinds[action]

        if (!b || !b.mods || !b.key)
            return false

        var combo =
            b.mods.toUpperCase().trim() +
            "+" +
            b.key.toUpperCase().trim()

        return !!(
            root._comboMap[combo] &&
            root._comboMap[combo].length > 1
        )
    }

    function conflictsWith(action) {
        var b = root.keybinds[action]

        if (!b || !b.mods || !b.key)
            return ""

        var combo =
            b.mods.toUpperCase().trim() +
            "+" +
            b.key.toUpperCase().trim()

        var list = root._comboMap[combo]

        if (!list || list.length < 2)
            return ""

        for (var i = 0; i < list.length; i++) {
            if (list[i] !== action) {
                var other = root.keybinds[list[i]]
                return other ? other.label : list[i]
            }
        }

        return ""
    }

    function wouldConflict(action, mods, key) {
        var combo =
            (mods || "").toUpperCase().trim() +
            "+" +
            (key || "").toUpperCase().trim()

        var ks = Object.keys(root.keybinds)

        for (var i = 0; i < ks.length; i++) {
            if (ks[i] === action)
                continue

            var b = root.keybinds[ks[i]]

            if (!b || !b.mods || !b.key)
                continue

            var otherCombo =
                b.mods.toUpperCase().trim() +
                "+" +
                b.key.toUpperCase().trim()

            if (otherCombo === combo)
                return b.label || ks[i]
        }

        return ""
    }


    // =========================================================================
    // Load saved overrides
    // =========================================================================

    property var _loadProc: Process {
        command: [
            "bash",
            "-c",
            "[ -f '" + root._jsonPath + "' ] && cat '" +
            root._jsonPath +
            "' || echo '{}'"
        ]

        running: false

        stdout: StdioCollector {
            onStreamFinished: {

                var merged = {}
                var defs = root._defaults
                var dkeys = Object.keys(defs)

                for (var i = 0; i < dkeys.length; i++) {
                    var dk = dkeys[i]
                    var d = defs[dk]

                    merged[dk] = {
                        mods: d.mods || "",
                        key: d.key || "",
                        label: d.label || dk,
                        group: d.group || "Other",
                        kind: d.kind || "ipc",
                        cmd: d.cmd || ""
                    }
                }

                try {
                    var saved = JSON.parse(text.trim())
                    var sk = Object.keys(saved)

                    for (var j = 0; j < sk.length; j++) {
                        var s = sk[j]

                        if (!merged[s])
                            continue

                        if (saved[s].mods !== undefined)
                            merged[s].mods = saved[s].mods

                        if (saved[s].key !== undefined)
                            merged[s].key = saved[s].key
                    }
                } catch (e) {}

                root.keybinds = merged

                root._writeFiles()
                root._ensureInclude()
            }
        }
    }


    // =========================================================================
    // Save
    // =========================================================================

    function save() {
        var out = {}
        var defs = root._defaults
        var ks = Object.keys(root.keybinds)

        for (var i = 0; i < ks.length; i++) {
            var k = ks[i]
            var current = root.keybinds[k]
            var def = defs[k]

            if (!current || !def)
                continue

            if ((current.mods || "") !== (def.mods || "") ||
                (current.key || "") !== (def.key || "")) {

                out[k] = {
                    mods: current.mods || "",
                    key: current.key || ""
                }
            }
        }

        var json = JSON.stringify(out, null, 2)

        _saveProc.command = [
            "bash",
            "-c",
            "mkdir -p \"$(dirname '" +
            root._jsonPath +
            "')\" && printf '%s' '" +
            json.replace(/'/g, "'\\''") +
            "' > '" +
            root._jsonPath +
            "'"
        ]

        _saveProc.running = false
        _saveProc.running = true

        root._writeFiles()
    }

    property var _saveProc: Process {
        command: []
        running: false
    }


    // =========================================================================
    // Hyprland reload
    // =========================================================================

    property var _reloadProc: Process {
        command: ["hyprctl", "reload"]
        running: false
    }

    property var _reloadTimer: Timer {
        interval: 350
        repeat: false

        onTriggered: {
            root._reloadProc.running = false
            root._reloadProc.running = true
        }
    }

    function reload() {
        _reloadTimer.restart()
    }

    function saveAndReload() {
        save()
        reload()
    }


    // =========================================================================
    // Update / reset / unbind
    // =========================================================================

    function updateBinding(action, newMods, newKey) {
        var old = root.keybinds[action]

        if (!old)
            return

        var m = (newMods || "").toUpperCase().trim()
        var k = (newKey || "").toUpperCase().trim()

        if (m === "" || k === "")
            return

        if (root.wouldConflict(action, m, k) !== "")
            return

        var copy = Object.assign({}, root.keybinds)

        copy[action] = {
            mods: m,
            key: k,
            label: old.label,
            group: old.group,
            kind: old.kind || "ipc",
            cmd: old.cmd || ""
        }

        root.keybinds = copy
    }

    function resetBinding(action) {
        var def = root._defaults[action]

        if (!def)
            return

        var copy = Object.assign({}, root.keybinds)

        copy[action] = {
            mods: def.mods || "",
            key: def.key || "",
            label: def.label || action,
            group: def.group || "Other",
            kind: def.kind || "ipc",
            cmd: def.cmd || ""
        }

        root.keybinds = copy

        saveAndReload()
    }

    function unbindBinding(action) {
        var old = root.keybinds[action]

        if (!old)
            return

        var copy = Object.assign({}, root.keybinds)

        copy[action] = {
            mods: "",
            key: "",
            label: old.label,
            group: old.group,
            kind: old.kind || "ipc",
            cmd: old.cmd || ""
        }

        root.keybinds = copy

        saveAndReload()
    }


    // =========================================================================
    // File generation
    // =========================================================================

    property var _writeProc: Process {
        command: []
        running: false
    }

    function _writeFiles() {
        var lua = _genLua()
        var conf = _genConf()

        var le =
            lua
            .replace(/\\/g, "\\\\")
            .replace(/'/g, "'\\''")

        var ce =
            conf
            .replace(/\\/g, "\\\\")
            .replace(/'/g, "'\\''")

        _writeProc.command = [
            "bash",
            "-c",
            "mkdir -p '" +
            root._configDir +
            "' && printf '%s' '" +
            le +
            "' > '" +
            root._luaPath +
            "' && printf '%s' '" +
            ce +
            "' > '" +
            root._confPath +
            "'"
        ]

        _writeProc.running = false
        _writeProc.running = true
    }


    function _grouped() {
        var groups = {}
        var order = []
        var ks = Object.keys(root.keybinds)

        for (var i = 0; i < ks.length; i++) {
            var k = ks[i]
            var b = root.keybinds[k]

            if (!b || !b.mods || !b.key)
                continue

            var g = b.group || "Other"

            if (!groups[g]) {
                groups[g] = []
                order.push(g)
            }

            groups[g].push({
                k: k,
                mods: b.mods,
                key: b.key,
                label: b.label,
                kind: b.kind || "ipc",
                cmd: b.cmd || ""
            })
        }

        return {
            groups: groups,
            order: order
        }
    }


    function _escapeLuaString(value) {
        return (value || "")
            .replace(/\\/g, "\\\\")
            .replace(/"/g, "\\\"")
            .replace(/\n/g, "\\n")
            .replace(/\r/g, "\\r")
    }


    function _bindCombo(mods, key) {
        if (mods && mods.trim() !== "")
            return mods.trim() + " + " + key

        return key
    }


    function _genLua() {
        var sd = root._shellDir
            .replace(/\\/g, "\\\\")
            .replace(/"/g, "\\\"")

        var data = _grouped()

        var lines = [
            "-- ==============================================================================",
            "-- Brain Shell Keybinds",
            "-- Auto-generated by Quickshell. Do not edit manually.",
            "-- ==============================================================================",
            "",
            "local shell = \"" + sd + "\"",
            "",
            "-- ==============================================================================",
            "-- BrainShell Capture Submap",
            "-- ==============================================================================",
            "hl.define_submap(\"BrainShell_clean\", function()",
            "    hl.bind(\"CTRL + ESCAPE\", function()",
            "        hl.dispatch(hl.dsp.exec_cmd(\"notify-send 'BrainShell' 'Emergency Exit: Keybinds re-enabled.'\"))",
            "        hl.dispatch(hl.dsp.submap(\"reset\"))",
            "    end, { description = \"Emergency return to global submap\" })",
            "end)",
            "",
            "-- ==============================================================================",
            "-- Managed Bindings",
            "-- ==============================================================================",
            ""
        ]

        for (var gi = 0; gi < data.order.length; gi++) {
            var g = data.order[gi]

            lines.push("-- " + g)

            var entries = data.groups[g]

            for (var ei = 0; ei < entries.length; ei++) {
                var e = entries[ei]
                var combo = _bindCombo(e.mods, e.key)

                if (e.kind === "exec") {
                    var cmd = _escapeLuaString(e.cmd)

                    lines.push(
                        "hl.bind(\"" +
                        combo +
                        "\", hl.dsp.exec_cmd(\"" +
                        cmd +
                        "\"))"
                    )
                } else {
                    lines.push(
                        "hl.bind(\"" +
                        combo +
                        "\", hl.dsp.exec_cmd(\"qs ipc -c \" .. shell .. \" call " +
                        e.k +
                        " toggle\"))"
                    )
                }
            }

            lines.push("")
        }

        return lines.join("\n")
    }


    function _genConf() {
        var data = _grouped()

        var lines = [
            "# ==============================================================================",
            "# Brain Shell Keybinds",
            "# Auto-generated by Quickshell. Do not edit manually.",
            "# ==============================================================================",
            "",
            "# ==============================================================================",
            "# BrainShell Capture Submap",
            "# ==============================================================================",
            "submap = BrainShell_clean",
            "bind = CTRL, ESCAPE, exec, notify-send 'BrainShell' 'Emergency Exit: Keybinds re-enabled.'",
            "bind = CTRL, ESCAPE, submap, reset",
            "submap = reset",
            "",
            "# ==============================================================================",
            "# Managed Bindings",
            "# ==============================================================================",
            ""
        ]

        for (var gi = 0; gi < data.order.length; gi++) {
            var g = data.order[gi]

            lines.push("# " + g)

            var entries = data.groups[g]

            for (var ei = 0; ei < entries.length; ei++) {
                var e = entries[ei]
                var confMods =
                    (e.mods || "").replace(/\s*\+\s*/g, " ")

                if (e.kind === "exec") {
                    lines.push(
                        "bind = " +
                        confMods +
                        (confMods ? ", " : "") +
                        e.key +
                        ", exec, " +
                        e.cmd
                    )
                } else {
                    lines.push(
                        "bind = " +
                        confMods +
                        (confMods ? ", " : "") +
                        e.key +
                        ", exec, qs ipc -c " +
                        root._shellDir +
                        " call " +
                        e.k +
                        " toggle"
                    )
                }
            }

            lines.push("")
        }

        return lines.join("\n")
    }


    // =========================================================================
    // Auto include generated binding file
    // =========================================================================

    property var _includeProc: Process {
        command: []
        running: false
    }

    function _ensureInclude() {
        var lp = root._luaPath
            .replace(/"/g, "\\\"")

        var cp = root._confPath
            .replace(/"/g, "\\\"")

        if (configProvider === "lua") {
            _includeProc.command = [
                "bash",
                "-c",
                [
                    "MARKER='Brain_ShellKeybinds'",
                    "LUA=\"$HOME/.config/hypr/hyprland.lua\"",
                    "if [ -f \"$LUA\" ] && ! grep -qF \"$MARKER\" \"$LUA\"; then",
                    "  printf '\\n-- Brain_ShellKeybinds\\ndofile(\"" +
                    lp +
                    "\")\\n' >> \"$LUA\"",
                    "fi"
                ].join("\n")
            ]
        } else {
            _includeProc.command = [
                "bash",
                "-c",
                [
                    "MARKER='Brain_ShellKeybinds'",
                    "CONF=\"$HOME/.config/hypr/hyprland.conf\"",
                    "if [ -f \"$CONF\" ] && ! grep -qF \"$MARKER\" \"$CONF\"; then",
                    "  printf '\\n# Brain_ShellKeybinds\\nsource = " +
                    cp +
                    "\\n' >> \"$CONF\"",
                    "fi"
                ].join("\n")
            ]
        }

        _includeProc.running = false
        _includeProc.running = true
    }


    // =========================================================================
    // Startup
    // =========================================================================

    Component.onCompleted: {
        _loadProc.running = true
    }
}
